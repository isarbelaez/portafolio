---
import Header from '../components/Header';
import PortfolioTabs from '../components/PortfolioTabs';
import Footer from '../components/Footer';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={import.meta.env.BASE_URL.replace(/\/$/, '') + "/favicon.png"} />
    <meta name="viewport" content="width=device-width" />
    <title>Isabella Arbelaez — Estratega de Marketing, UX/UI y Automatización IA</title>
    
    <meta name="description" content="Explora el portafolio de Isabella Arbelaez, estratega experta en Marketing, Diseño UX/UI y Automatización IA para potenciar y escalar negocios digitales." />
    <meta name="keywords" content="Isabella Arbelaez, Marketing Estratégico, Diseño UX/UI, Automatización IA, n8n, Kommo CRM, Estratega Digital, Portfolio" />
    <link rel="canonical" href="https://isarbelaez.github.io/portafolio/" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://isarbelaez.github.io/portafolio/" />
    <meta property="og:title" content="Isabella Arbelaez — Marketing, UX/UI & Automatización" />
    <meta property="og:description" content="Estratega de Marketing y Diseñadora UX/UI especializada en el uso de IA para escalar negocios." />
    <meta property="og:image" content={new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + "/og-image.png", "https://isarbelaez.github.io/portafolio/").href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://isarbelaez.github.io/portafolio/" />
    <meta property="twitter:title" content="Isabella Arbelaez — Portfolio" />
    <meta property="twitter:description" content="Estratega de Marketing y Diseñadora UX/UI especializada en el uso de IA para escalar negocios." />
    <meta property="twitter:image" content={new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + "/og-image.png", "https://isarbelaez.github.io/portafolio/").href} />

    <meta name="generator" content={Astro.generator} />
    <!-- Modern Sans-Serif Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-[#FDFBF7] text-[#3E2723] font-inter selection:bg-[#D7CCC8]">
    <div class="absolute inset-0 z-[-1] bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(111,78,55,0.05),rgba(255,255,255,0))]"></div>
    
    <Header client:load />
    <PortfolioTabs client:load />
    <Footer client:load />

  </body>
</html>

