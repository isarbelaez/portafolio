---
import SidebarLayout from "../layouts/SidebarLayout.astro";
import HomeContent from "../components/HomeContent";

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Isabella Arbelaez",
  url: "https://isarbelaez.github.io/portafolio/",
  description:
    "Estratega experta en Marketing Digital, Diseño UX/UI centrado en conversión y Automatización con IA.",
  knowsAbout: [
    "Marketing Digital",
    "Diseño UX/UI",
    "IA",
    "Automatización",
    "n8n",
    "Kommo CRM",
    "Growth Strategy",
  ],
};
---

<SidebarLayout
  title="Isa Arbelaez | Diseño Web, UX/UI y Automatizaciones IA"
  description="Diseñamos sistemas digitales que convierten negocios en resultados. Especialistas en desarrollo web, Growth B2B y automatización de procesos."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <HomeContent client:load />
</SidebarLayout>
