---
import Header from '../components/Header';
import PortfolioTabs from '../components/PortfolioTabs';
import Footer from '../components/Footer';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "favicon.svg"} />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Portafolio de Isabella Arbelaez — Estratega de Marketing, UX/UI y Automatizaciones con IA" />
    <meta name="generator" content={Astro.generator} />
    <title>Isabella Arbelaez — Portfolio</title>
    <!-- Modern Sans-Serif Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-[#FDFBF7] text-[#3E2723] font-inter selection:bg-[#D7CCC8]">
    <div class="absolute inset-0 z-[-1] bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(111,78,55,0.05),rgba(255,255,255,0))]"></div>
    
    <Header client:load />
    <PortfolioTabs client:load />
    <Footer client:load />

  </body>
</html>

